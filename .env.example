# Copy this file to .env and fill in your own key:
#     copy .env.example .env      (Command Prompt / PowerShell)
#     cp .env.example .env        (Mac / Linux)
# .env.example is safe to upload because it has no keys in it. .env is NOT.

# Which LLM writes the answers: claude, openai (ChatGPT) or gemini
LLM_PROVIDER=claude

# Optional: a different model name for the provider above.
# Leave empty to use the default (claude-opus-5-5 / gpt-5-nano / gemini-3.8-flash)
LLM_MODEL=

# API keys - you only need the one for the provider you picked above.
# Never share your .env file or upload it to GitHub!
# Claude:  https://platform.claude.com  -> Settings -> API keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini:  https://aistudio.google.com/apikey
GEMINI_API_KEY=
